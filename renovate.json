{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun"],
  "includePaths": ["reflex.lock/**"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": ["bun"],
      "groupName": "frontend"
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
